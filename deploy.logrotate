# Log rotation for git-deploy-toolkit: installed as /etc/logrotate.d/git-deploy-muffins on each deploy and
# run by the nightly logrotate timer. See deploy.conf for the rest of the deploy setup.
#
# Retention follows the MLP Vector Club privacy policy ("Log Data", Winterchilla repo,
# templates/about/privacy.html.twig): server logs are "kept for up to 14 days and discarded afterwards". The
# app's console output can contain request details, so it gets the same limit. `daily` with `rotate 13` is what
# makes that "up to 14 days": the current file holds at most one day and the 13 rotated ones the 13 days before
# it. If the policy's number changes, change this to (days - 1).
#
# The files are written by the pm2 process (pm2.json: out_file/error_file, merge_logs so pm2
# doesn't put the process id in the name), which runs as the deploy user, hence `su`. pm2 keeps them open, so
# copy and truncate instead of moving them.
@WORKTREE@/logs/pm2-out.log
@WORKTREE@/logs/pm2-error.log {
    su pwny pwny
    daily
    rotate 13
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}
